# ============================================================
# .env.example — 复制为 .env 后根据环境修改
# ============================================================

# RapidAPI
RAPIDAPI_KEY=your_rapidapi_key_here

# ---- Runtime backend ----
# mysql = 保持旧链路；postgresql = 启用 AWS PostgreSQL Data Platform
DB_DIALECT=postgresql
STORE_TO_DB=true

# ---- AWS ----
AWS_REGION=ap-southeast-1
AWS_PROFILE=
AWS_SECRET_NAME=
AWS_SECRET_FALLBACK_TO_ENV=true

# ---- S3 raw archive ----
S3_RAW_BUCKET=
S3_RAW_PREFIX=raw
S3_SERVER_SIDE_ENCRYPTION=

# ---- PostgreSQL (可作为 Secrets Manager 回退) ----
# 如果 AWS Secret 可用，会优先读取 secret；否则回退到下列显式账号密码
PGHOST=
PGPORT=5432
PGDATABASE=ecommerce_platform
PGUSER=
PGPASSWORD=
PGSSLMODE=prefer
PGAPPNAME=ecommerce-data-collector-analysis

# ---- Bastion / SSH tunnel ----
# RDS 需通过 VPC 内 bastion 访问时启用
DB_REQUIRE_SSH=true
BASTION_HOST=
BASTION_PORT=22
BASTION_USER=ec2-user
BASTION_SSH_PKEY=

# ---- Airflow scheduling (server deployment) ----
AIRFLOW_DAG_AMAZON_SEARCH_CRON=0 */6 * * *
AIRFLOW_DAG_OWNER=data-platform
AIRFLOW_DAG_RETRIES=1
AIRFLOW_DAG_RETRY_DELAY_MINUTES=10
AIRFLOW_AMAZON_SEARCH_QUERY=coffee maker
AIRFLOW_AMAZON_COUNTRY=US
AIRFLOW_AMAZON_SEARCH_PAGE=1
AIRFLOW_AMAZON_ACCOUNT=default
AIRFLOW_AMAZON_BUSINESS_DOMAIN=thirdparty-market-intelligence
AIRFLOW_AMAZON_DATASET_NAME=amazon_product_catalog_search_airflow
AIRFLOW_AMAZON_COLLECTION_PURPOSE=scheduled_market_monitoring
AIRFLOW_AMAZON_DETAIL_ASIN_LIMIT=10
AIRFLOW_AMAZON_OFFER_ASIN_LIMIT=10
AIRFLOW_AMAZON_REVIEW_ASIN_LIMIT=5
AIRFLOW_AMAZON_ENABLE_OFFERS=true
AIRFLOW_AMAZON_ENABLE_REVIEWS=false
AIRFLOW_AMAZON_DETAIL_DATASET_NAME=amazon_product_catalog_detail_airflow
AIRFLOW_AMAZON_OFFER_DATASET_NAME=amazon_product_offers_airflow
AIRFLOW_AMAZON_REVIEW_DATASET_NAME=amazon_product_reviews_airflow

# ---- Legacy MySQL settings (backward compatible) ----
# 本地开发（需先运行 bash scripts/start-rds-tunnel.sh）：
#   DB_HOST=127.0.0.1
#   DB_PORT=3307
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=gurryshark
DB_PASSWORD=
DB_NAME=gurysk_src

# ---- Legacy SSH aliases ----
SSH_HOST=
SSH_PORT=22
SSH_USERNAME=ec2-user
SSH_PKEY=
